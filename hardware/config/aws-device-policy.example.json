{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:ap-south-1:YOUR_ACCOUNT_ID:client/Aervia_sensors"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:iot:ap-south-1:YOUR_ACCOUNT_ID:topic/aervia/Aervia_sensors/telemetry"
    }
  ]
}
