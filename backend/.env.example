# Google Gemini API key. Keep this secret; never put it in frontend code or commit it.
GEMINI_API_KEY=

# Use Gemini for wording only. The deterministic rules choose the recommendations.
AERVIA_ADVISORY_LLM_ENABLED=false
GEMINI_MODEL=gemini-3.8-flash

# Output language: en (English), hi (Hindi), kn (Kannada). English is the default.
AERVIA_ADVISORY_LANGUAGE=en
AERVIA_ADVISORY_MAX_ACTIONS=4