# Provider credentials (leave blank to disable the related integration)
# CPCB CAAQMS data is accessed through the data.gov.in API.
DATAGOV_API_KEY=
CPCB_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
OPENAQ_API_KEY=
TOMTOM_API_KEY=
GEMINI_API_KEY=
NASA_FIRMS_MAP_KEY=

# Public frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# App and container configuration. Replace these placeholders before Docker use.
JWT_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=aervia
POSTGRES_USER=aerviauser
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=sqlite:///./aervia.db
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional mobile notification integration
MOBILE_WEBHOOK_URL=
MOBILE_WEBHOOK_SECRET=
